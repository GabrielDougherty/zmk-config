#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
     behaviors {
        // empty for now, but the section needs to exist
    };
    
    combos {
        compatible = "zmk,combos";
        studio_unlock {
            timeout-ms = <200>;
            key-positions = <0 8>;  // adjust to two keys you can press together
            bindings = <&studio_unlock>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// Matrix layout (col0=leftmost, col5=rightmost):
// Left:  [ empty,   W,    E,    R,    T,  empty ] | Right: [ empty,   Y,    U,    I,    O,  empty ]
// Left:  [   Q,     S,    D,    F,    G,  empty ] | Right: [ empty,   H,    J,    K,    L,  empty ]  
// Left:  [   A,     X,    C,    V,    B,  empty ] | Right: [ empty,   N,    M,   ,,    .,  empty ]
// Left:  [   Z,     1,    2,    3,    4,    5   ] | Right: [   6,     7,    8,    9,    0,    P   ]
            bindings = <
                    &kp W   &kp E   &kp R   &kp T                           &kp Y   &kp U   &kp I   &kp O
   &kp Q    &kp S   &kp D   &kp F   &kp G           &kp H   &kp J   &kp K   &kp L   &kp P
   &kp A    &kp X   &kp C   &kp V   &kp B           &kp N   &kp M   &kp COMMA &kp DOT &kp SEMI
   &kp Z    &kp N1  &kp N2  &kp N3  &kp N4  &kp &sys_reset  &kp &sys_reset  &kp N7  &kp N8  &kp N9  &kp N0  &kp SLASH
            >;
        };
	   layer_1 {
        display-name = "Layer 1";
        bindings = <
                &trans  &trans  &trans  &trans                           &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        >;
    };

    layer_2 {
        display-name = "Layer 2";
        bindings = <
                &trans  &trans  &trans  &trans                           &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        >;
    };
    };
};
